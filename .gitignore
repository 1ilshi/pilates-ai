# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log*
firebase-debug.*.log*

# Firebase cache
.firebase/

# Firebase config
config/*-sdk.json
service-account*.json
*firebase-adminsdk*.json
.env.*

# Uncomment this if you'd like others to create their own Firebase project.
# For a team working on the same Firebase project(s), it is recommended to leave
# it commented so all members can deploy to the same project(s) in .firebaserc.
# .firebaserc

# Runtime data
__pycache__/
*.py[cod]
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env

# dataconnect generated files
.dataconnect

# Ignore build artifacts
/dist/
/build/

# Ignore virtual environments
/venv/
# The local Python toolchain (export/verify scripts). ~1.4 GB; never commit.
.venv/

# Large deliverable binaries kept out of git history
final.pdf

# (Optionally) Ignore logs if you want them to be generated at runtime
/logs/
/pilates.db
/pilates.db-shm
/pilates.db-wal

#ignore bfg.jar report
/..bfg-report/

# Monorepo build / test artifacts
apps/*/dist/
packages/*/dist/
packages/viz/smoke/smoke.bundle.cjs
.turbo/
*.tsbuildinfo

# Rust build artifacts (Cargo target dirs can be >1 GB)
target/

# Fetched ONNX Runtime binaries (~17 MB Windows, ~37 MB macOS, ~11 MB Linux)
# and the download cache. Restore with: python tools/fetch_onnxruntime.py
apps/desktop/src-tauri/resources/*.dll
apps/desktop/src-tauri/resources/*.dylib
apps/desktop/src-tauri/resources/*.so
apps/desktop/src-tauri/resources/*.so.*
apps/desktop/src-tauri/resources/.cache/

# Staging directory for release assets (tools/build-update-manifest.mjs)
/release-assets/

# Local pnpm store and temporary build directories used by release checks
.pnpm-store/
.tmp-build/
.cargo-target-*/

# Trained PyTorch weights. config/models/*.onnx is what ships; the .pt files
# are only needed to re-export, and they were 31 MB of the repository.
# Regenerate with tools/export_onnx.py, which expects assets/models/poseN/best.pt.
/assets/models/
*.pt
