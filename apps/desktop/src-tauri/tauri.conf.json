{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Pilates AI",
  "version": "2.0.8",
  "identifier": "com.pilatesai.workstation",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pilates AI Clinical Workstation",
        "width": 1280,
        "height": 850,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/1ilshi/pilates-ai/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY4QjA0QUZBNEY0N0ZCQTkKUldTcCswZFAra3F3YUlCUUdleS9wZmJqMVM3eTVUd0NpUVJZRk43Qkphbkhwcng0NXRiNnI1YXkK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Pilates AI",
    "copyright": "Copyright © 2026 Pilates AI",
    "category": "Medical",
    "shortDescription": "Pilates AI clinical workstation",
    "longDescription": "Records and analyses pilates exercise sessions with on-device pose detection. Video is processed locally and never leaves the workstation.",
    "license": "Proprietary",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../config/models/*.onnx": "config/models/",
      "../../../config/model-manifest.json": "config/model-manifest.json",
      "../../../config/pose-definitions.json": "config/pose-definitions.json",
      "resources/*": "resources/"
    }
  }
}
