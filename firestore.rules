rules_version = '2';

// Firestore security rules for the Pilates AI clinic database.
//
// Two rules shape everything below:
//
// 1. **Field ownership.** The desktop owns the profile fields; the Cloud
//    Function alone owns the derived aggregates (`total_sessions`,
//    `lifetime_avg_score`, `last_active`). Before this file existed a stale
//    workstation could echo a `total_sessions` it had read minutes earlier and
//    silently undo an aggregate the function had just computed.
//
// 2. **Server-owned collections are invisible to clients.** `sessionLedger`
//    makes the aggregation trigger idempotent, `syncState/current` is the
//    change marker every workstation polls, and `portalLogins` holds one-time
//    browser sign-in codes. A client able to write any of them could
//    double-count sessions, forge a change notification, or mint a portal
//    session.
//
// **Access model.** Any account that exists in Firebase Auth may read and write
// clinic data. Accounts are created only by the administrator in the Firebase
// console, and new-user sign-up is disabled, so account existence *is* the
// roster. The earlier `clinic` custom claim was removed because provisioning it
// was a separate CLI step that silently locked out every newly created account.
// To restore a claim boundary, put `request.auth.token.clinic == '...'` back in
// `isSignedIn()` and re-run `functions/scripts/set-clinic-claim.mjs`.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Identity
    // ---------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // ---------------------------------------------------------------------
    // Field ownership
    // ---------------------------------------------------------------------

    // Fields the desktop writes. `address`, `note` and `tel_number` are here
    // so the profile form can edit them; they were read-only before.
    function patientOwnedFields() {
      return [
        'name', 'age', 'weight', 'height', 'gender',
        'address', 'note', 'tel_number',
        'revision', 'local_state', 'updated_by', 'last_origin'
      ];
    }

    function validName() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200;
    }

    match /patients/{patientId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && validName()
        && request.resource.data.keys().hasOnly(patientOwnedFields());

      allow update: if isSignedIn()
        && validName()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(patientOwnedFields());

      // Deletions are soft (`local_state = 'tombstone'`): the session
      // subcollection must survive, and a client must not be able to destroy
      // a clinical record outright.
      allow delete: if false;

      // -------------------------------------------------------------------
      // Sessions: written once, by the workstation that recorded them.
      // -------------------------------------------------------------------
      match /sessions/{sessionId} {
        allow read: if isSignedIn();

        allow create: if isSignedIn()
          && request.resource.data.keys()
               .hasAll(['session_id', 'patient_id', 'pose_id', 'started_at',
                        'completed_at', 'summary', 'reps', 'kinematic_curve'])
          && request.resource.data.session_id == sessionId
          && request.resource.data.patient_id == patientId
          && request.resource.data.completed_at is string
          && request.resource.data.summary is map
          && request.resource.data.reps is list
          && request.resource.data.kinematic_curve is list;

        // A completed session is an immutable clinical record.
        allow update, delete: if false;
      }

      // -------------------------------------------------------------------
      // Clinical comments: append and remove, never edit.
      // -------------------------------------------------------------------
      match /comments/{commentId} {
        allow read: if isSignedIn();

        allow create: if isSignedIn()
          && request.resource.data.keys().hasAll(['text', 'created_at'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000;

        allow delete: if isSignedIn();
        allow update: if false;
      }
    }

    // ---------------------------------------------------------------------
    // Collection-group reads
    // ---------------------------------------------------------------------

    // The portal lists recent sessions across every patient in a single query
    // (`collectionGroup("sessions")`). Firestore authorises that from a rule
    // matching the collection group itself: the nested
    // `/patients/{patientId}/sessions/{sessionId}` block above covers a known
    // patient, not a cross-patient query, so the portal was denied while every
    // ordinary read succeeded.
    //
    // Read-only: creating, updating and deleting a session still goes through
    // the nested block, where the patient and session ids are checked.
    match /{path=**}/sessions/{sessionId} {
      allow read: if isSignedIn();
    }

    // ---------------------------------------------------------------------
    // Server-owned collections
    // ---------------------------------------------------------------------

    // Idempotency ledger for the aggregation trigger. Deleting an entry would
    // let a redelivered event count the same session twice.
    match /sessionLedger/{sessionId} {
      allow read, write: if false;
    }

    // The change marker the desktops poll. Read-only for clients: a forged
    // bump would make every workstation re-download the whole roster.
    match /syncState/{document} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Device pairing records, including their rate-limit counters. Written and
    // read only by the Cloud Functions (the Admin SDK bypasses these rules).
    // A client that could read one would learn which codes are outstanding, and
    // one that could write would be able to approve its own workstation.
    match /devicePairings/{document} {
      allow read, write: if false;
    }

    // One-time codes that hand a desktop session to the browser portal. Written
    // and read only by the Cloud Functions; a client that could read one could
    // exchange another workstation's code for a signed-in portal session.
    match /portalLogins/{document} {
      allow read, write: if false;
    }
  }
}
