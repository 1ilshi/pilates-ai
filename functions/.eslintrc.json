{
  "env": {
    "node": true,
    "es2021": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "script"
  },
  "rules": {
    "quotes": ["error", "double"],
    "max-len": ["error", { "code": 80 }],
    "indent": ["error", 2],
    "camelcase": "error",
    "comma-dangle": ["error", "never"],
    "object-curly-spacing": ["error", "never"],
    "one-var": ["error", "never"]
  }
}
